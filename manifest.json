{
  "manifest_version": 3,
  "name": "Chord Side Panel - Hợp âm bên cạnh YouTube",
  "version": "0.3.0",
  "description": "Xem Hợp Âm Chuẩn trong side panel cạnh video YouTube, tự động bắt tên bài, cuộn tự động và chia 2 cột.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "https://hopamchuan.com/*",
    "https://*.hopamchuan.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Mở hợp âm bên cạnh YouTube",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Bật/Tắt Side Panel hợp âm"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://hopamchuan.com/*",
        "https://*.hopamchuan.com/*"
      ],
      "all_frames": true,
      "css": ["content/hac.css"],
      "js": ["content/hac.js"],
      "run_at": "document_idle"
    }
  ]
}
