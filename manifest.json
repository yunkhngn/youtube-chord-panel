{
  "manifest_version": 3,
  "name": "Youtube Chord Panel",
  "version": "0.1.0",
  "description": "Mở Hợp Âm Chuẩn / Ultimate Guitar trong side panel cạnh video YouTube, có tìm nhanh theo tên bài.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "https://hopamchuan.com/*",
    "https://*.hopamchuan.com/*",
    "https://www.ultimate-guitar.com/*",
    "https://tabs.ultimate-guitar.com/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Mở hợp âm"
  }
}